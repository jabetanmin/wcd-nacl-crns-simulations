<?xml version='1.0' encoding='ISO-8859-1'?>

<!--
  Irradiación del WCD con una fuente puntual 241Am-Be (1 Ci, 5 min), a 10 cm de la pared
  lateral exterior y a media altura del agua.

  injectionMode eFromFile: MEIGA toma la posición de cada neutrón de las columnas x, y, z del
  archivo (en cm). Todas las líneas tienen la posición de la fuente (-58.062, 0, 66.562) cm y una
  dirección isótropa que apunta al tanque. Las coordenadas de abajo no se usan en este modo.

  Geometría igual a la réplica de Sidelnik (SaltyWCD sin cambios): agua R = 48 cm, H = 133 cm,
  Tyvek 0,12 mm + acero 0,5 mm; fondo exterior en z = 0; eje del tanque en x = y = 0.
  Para NaCl, cambiar impuritiesFraction (0.025 / 0.05 / 0.10).
-->
<detectorList>

	<injectionMode type="eFromFile">
		<x unit="cm"> 0 </x>
		<y unit="cm"> 0 </y>
		<z unit="cm"> 0 </z>
	</injectionMode>

	<detector id="0" type="eSaltyWCD">
		<x unit="cm"> 0.0 </x>
		<y unit="cm"> 0.0 </y>
		<z unit="cm"> 0.0 </z>
		<tankRadius unit="cm"> 48 </tankRadius>
		<tankHeight unit="cm"> 133 </tankHeight>
		<tankThickness unit="mm"> 0.5 </tankThickness>
		<impuritiesFraction> 0 </impuritiesFraction>
	</detector>

</detectorList>
