<?xml version='1.0' encoding='ISO-8859-1'?>

<!--
  Muones verticales (VEM) para calibrar p.e./ADC con el pico de muones del fondo medido.
  mu- de 4 GeV/c que entran por la tapa (z = 140 cm) y atraviesan todo el tanque.

  injectionMode eFromFile: MEIGA toma la posicion de cada muon de las columnas x, y, z del archivo
  (en cm): puntos al azar en un disco de radio 45 cm sobre la tapa; direccion vertical hacia abajo.
  Las coordenadas de abajo no se usan en este modo.

  Mismo detector que las corridas del montaje Am-Be: SaltyWCD, agua pura, R = 48 cm, H = 133 cm,
  Tyvek 0,12 mm + acero 0,5 mm, PMT de Sidelnik en la tapa.
-->
<detectorList>

	<injectionMode type="eFromFile">
		<x unit="cm"> 0 </x>
		<y unit="cm"> 0 </y>
		<z unit="cm"> 0 </z>
	</injectionMode>

	<detector id="0" type="eSaltyWCD">
		<x unit="cm"> 0.0 </x>
		<y unit="cm"> 0.0 </y>
		<z unit="cm"> 0.0 </z>
		<tankRadius unit="cm"> 48 </tankRadius>
		<tankHeight unit="cm"> 133 </tankHeight>
		<tankThickness unit="mm"> 0.5 </tankThickness>
		<impuritiesFraction> 0 </impuritiesFraction>
	</detector>

</detectorList>
