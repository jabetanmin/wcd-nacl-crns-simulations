<!--
  Montaje blindado 241Am-Be (haz 35 % / halo 45 % / fondo 20 %), irradiaci'on por el costado
  del tanque (fuente a 40 cm de la pared, media altura).

  injectionMode eFromFile: MEIGA toma la posici'on de cada neutr'on de las columnas x, y, z del
  archivo (en cm): el haz sale de la fuente (-88.062, 0, 66.562) cm; el halo y el fondo de planos a 1 mm
  de la pared. Las coordenadas de abajo no se usan en este modo.

  Geometr'ia igual a la r'eplica de Sidelnik (SaltyWCD sin cambios): agua R = 48 cm, H = 133 cm,
  Tyvek 0,12 mm + acero 0,5 mm; fondo exterior en z = 0; eje del tanque en x = y = 0.
  Medio: agua + 10 % NaCl (fraccion masica final, Ec. 3.12 de la tesis).
-->
<detectorList>

	<injectionMode type="eFromFile">
		<x unit="cm"> 0 </x>
		<y unit="cm"> 0 </y>
		<z unit="cm"> 0 </z>
	</injectionMode>

	<detector id="0" type="eSaltyWCD">
		<x unit="cm"> 0.0 </x>
		<y unit="cm"> 0.0 </y>
		<z unit="cm"> 0.0 </z>
		<tankRadius unit="cm"> 48 </tankRadius>
		<tankHeight unit="cm"> 133 </tankHeight>
		<tankThickness unit="mm"> 0.5 </tankThickness>
		<impuritiesFraction> 0.1 </impuritiesFraction>
	</detector>

</detectorList>
